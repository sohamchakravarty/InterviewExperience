                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('legacy externalId cache returns same order id', function () {",
                  "  pm.expect(json.id).to.eql(pm.environment.get('legacyDuplicateOrderId'));",
                  "});"
                ]
