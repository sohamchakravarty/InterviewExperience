              ]
            }
          }
        }
      ]
    },
    {
      "name": "Candidate Acceptance Tests",
      "description": "These tests are intended to fail on the starter code until the candidate implements the requested behavior.",
      "item": [
        {
          "name": "Idempotent Create By X-Request-Id - First Request",
          "event": [
