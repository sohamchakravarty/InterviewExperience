        {
          "name": "Promo FREESHIP Waives Shipping Only",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('freeShipExternalId', 'freeship-' + Date.now());",
                  "pm.environment.set('freeShipRequestId', 'freeship-req-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('FREESHIP removes standard shipping but keeps subtotal and tax', function () {",
                  "  const expected = 10.825;",
                  "  pm.expect(Math.abs(json.total - expected) < 0.0001).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{freeShipRequestId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"cust-2\",\n  \"externalId\": \"{{freeShipExternalId}}\",\n  \"currency\": \"USD\",\n  \"promoCode\": \"FREESHIP\",\n  \"expedite\": false,\n  \"items\": [\n    {\n      \"sku\": \"A-100\",\n      \"quantity\": 1,\n      \"unitPrice\": 10.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
