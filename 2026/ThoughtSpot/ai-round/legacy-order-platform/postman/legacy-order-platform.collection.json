              "raw": "{\n  \"customerId\": \"cust-2\",\n  \"externalId\": \"{{legacyDuplicateExternalId}}\",\n  \"currency\": \"USD\",\n  \"promoCode\": \"\",\n  \"expedite\": false,\n  \"items\": [\n    {\n      \"sku\": \"A-100\",\n      \"quantity\": 1,\n      \"unitPrice\": 29.99\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
