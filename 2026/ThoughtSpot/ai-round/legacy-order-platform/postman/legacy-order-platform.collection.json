{
  "info": {
    "name": "Legacy Order Platform",
    "_postman_id": "8ec31df1-bc21-4bd7-98c5-3b7ac3f72f01",
    "description": "Postman collection for the legacy Java interview service. Includes smoke checks and candidate acceptance checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('baseUrl')) {",
          "  pm.environment.set('baseUrl', 'http://localhost:8080');",
          "}",
          "if (!pm.environment.get('testRunId')) {",
          "  pm.environment.set('testRunId', String(Date.now()));",
          "}",
          "if (!pm.environment.get('requestId')) {",
          "  pm.environment.set('requestId', 'req-' + Date.now());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Smoke Tests",
      "description": "Requests expected to work against the current legacy implementation.",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('health payload shape is present', function () {",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json).to.have.property('orders');",
                  "  pm.expect(json).to.have.property('cacheEntries');",
                  "  pm.expect(json).to.have.property('auditEvents');",
                  "  pm.expect(json).to.have.property('reconciliationSnapshots');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('smokeExternalId', 'smoke-' + Date.now());",
                  "pm.environment.set('smokeRequestId', 'smoke-req-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.environment.set('createdOrderId', json.id);",
                  "pm.environment.set('createdExternalId', json.externalId);",
                  "pm.environment.set('createdPaymentReference', json.paymentReference);",
                  "pm.test('created order response has expected fields', function () {",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json.customerId).to.eql('cust-1');",
                  "  pm.expect(json.externalId).to.eql(pm.environment.get('smokeExternalId'));",
                  "  pm.expect(json.status).to.eql('CREATED');",
                  "  pm.expect(json.items).to.be.an('array').with.length(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{smokeRequestId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"cust-1\",\n  \"externalId\": \"{{smokeExternalId}}\",\n  \"currency\": \"USD\",\n  \"promoCode\": \"SAVE10\",\n  \"expedite\": true,\n  \"items\": [\n    {\n      \"sku\": \"A-100\",\n      \"quantity\": 2,\n      \"unitPrice\": 19.95\n    },\n    {\n      \"sku\": \"B-200\",\n      \"quantity\": 1,\n      \"unitPrice\": 5.49\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "List Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('list contains the created order', function () {",
                  "  pm.expect(json).to.be.an('array');",
                  "  const createdOrderId = pm.environment.get('createdOrderId');",
                  "  const found = json.some(order => order.id === createdOrderId);",
                  "  pm.expect(found).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "Admin Report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const text = pm.response.text();",
                  "pm.test('report looks like csv', function () {",
                  "  pm.expect(text).to.include('id,customerId,status,total,currency,createdAt,paymentReference,chargedAmount');",
                  "});",
                  "pm.test('report contains created order id', function () {",
                  "  const createdOrderId = pm.environment.get('createdOrderId');",
                  "  pm.expect(text).to.include(createdOrderId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/report",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "report"
              ]
            }
          }
        },
        {
